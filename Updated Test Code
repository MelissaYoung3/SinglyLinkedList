#include <iostream>

class Node {
public:
    int data;
    Node* next;
    Node(int val) : data(val), next(nullptr) {}
};

class SinglyLinkedList {
protected:
    Node* head;
    Node* tail;
    int count;

public:
    SinglyLinkedList() : head(nullptr), tail(nullptr), count(0) {}
    
    void insertAtEnd(int val) {
        Node* newNode = new Node(val);
        if (!head) {
            head = tail = newNode;
        } else {
            tail->next = newNode;
            tail = newNode;
        }
        count++;
    }
    
    void display() {
        Node* temp = head;
        std::cout << "list (" << count << "): ";
        while (temp) {
            std::cout << temp->data << " -> ";
            temp = temp->next;
        }
        std::cout << "nullptr" << std::endl;
    }
    
    bool isEmpty() {
        return head == nullptr;
    }
};

class SplitLinkedList : public SinglyLinkedList {
public:
    void splitList(SinglyLinkedList &evensList, SinglyLinkedList &oddsList) {
        Node* temp = head;
        while (temp) {
            if (temp->data % 2 == 0) {
                evensList.insertAtEnd(temp->data);
            } else {
                oddsList.insertAtEnd(temp->data);
            }
            temp = temp->next;
        }
        head = tail = nullptr;
        count = 0;
    }
};

int main() {
    SplitLinkedList list;
    SinglyLinkedList evensList, oddsList;
    int num;
    
    std::cout << "Enter integers ending with -999:" << std::endl;
    while (true) {
        std::cin >> num;
        if (num == -999) break;
        list.insertAtEnd(num);
    }
    
    list.display();
    list.splitList(evensList, oddsList);
    evensList.display();
    oddsList.display();
    list.display();
    
    return 0;
}

