#include <iostream>

class Node {
public:
    int data;
    Node* next;
    Node(int val) : data(val), next(nullptr) {}
};

class SinglyLinkedList {
private:
    Node* head;
public:
    SinglyLinkedList() : head(nullptr) {}

    void insertAtBeginning(int val) {
        Node* newNode = new Node(val);
        newNode->next = head;
        head = newNode;
    }

    void insertAtEnd(int val) {
        Node* newNode = new Node(val);
        if (!head) {
            head = newNode;
            return;
        }
        Node* temp = head;
        while (temp->next) {
            temp = temp->next;
        }
        temp->next = newNode;
    }

    void deleteFirst() {
        if (!head) return;
        Node* temp = head;
        head = head->next;
        delete temp;
    }

    void deleteLast() {
        if (!head) return;
        if (!head->next) {
            delete head;
            head = nullptr;
            return;
        }
        Node* temp = head;
        while (temp->next->next) {
            temp = temp->next;
        }
        delete temp->next;
        temp->next = nullptr;
    }

    void deleteMiddle(int val) {
        if (!head) return;
        if (head->data == val) {
            deleteFirst();
            return;
        }
        Node* temp = head;
        while (temp->next && temp->next->data != val) {
            temp = temp->next;
        }
        if (temp->next) {
            Node* toDelete = temp->next;
            temp->next = temp->next->next;
            delete toDelete;
        }
    }

    void display() {
        Node* temp = head;
        while (temp) {
            std::cout << temp->data << " -> ";
            temp = temp->next;
        }
        std::cout << "nullptr" << std::endl;
    }

    void buildReverseList() {
        SinglyLinkedList tempList;
        Node* temp = head;
        while (temp) {
            tempList.insertAtBeginning(temp->data);
            temp = temp->next;
        }
        head = tempList.head;
    }
};

int main() {
    SinglyLinkedList list;

    // Building a forward list
    std::cout << "Build a forward list" << std::endl;
    list.insertAtBeginning(50);
    list.insertAtBeginning(40);
    list.insertAtBeginning(30);
    list.insertAtBeginning(20);
    list.insertAtBeginning(10);
    list.display();

    std::cout << "Delete the first node" << std::endl;
    list.deleteFirst();
    list.display();

    std::cout << "Delete the last node" << std::endl;
    list.deleteLast();
    list.display();

    std::cout << "Delete the middle node" << std::endl;
    list.deleteMiddle(30);
    list.display();

    // Building a backward list
    std::cout << "Build a backward list" << std::endl;
    SinglyLinkedList reverseList;
    reverseList.insertAtBeginning(10);
    reverseList.insertAtBeginning(20);
    reverseList.insertAtBeginning(30);
    reverseList.insertAtBeginning(40);
    reverseList.insertAtBeginning(50);
    reverseList.display();

    std::cout << "Delete the first node" << std::endl;
    reverseList.deleteFirst();
    reverseList.display();

    std::cout << "Delete the last node" << std::endl;
    reverseList.deleteLast();
    reverseList.display();

    std::cout << "Delete the middle node" << std::endl;
    reverseList.deleteMiddle(30);
    reverseList.display();

    return 0;
}
